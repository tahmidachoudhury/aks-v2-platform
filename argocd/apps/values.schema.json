{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["repoURL", "targetRevision", "azure", "services"],
  "properties": {
    "repoURL": { "type": "string", "minLength": 1 },
    "targetRevision": { "type": "string", "minLength": 1 },
    "azure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acrLoginServer", "keyVaultUri", "subscriptionId", "dnsZoneName", "dnsZoneResourceGroup",
        "serviceBusNamespace", "serviceBusNamespaceName", "serviceBusQueue", "clientIds"
      ],
      "properties": {
        "acrLoginServer": { "type": "string", "pattern": "^[a-z0-9]+\\.azurecr\\.io$" },
        "keyVaultUri": { "type": "string", "pattern": "^https://[a-z0-9-]+\\.vault\\.azure\\.net/$" },
        "subscriptionId": { "$ref": "#/definitions/guid" },
        "dnsZoneName": { "type": "string", "minLength": 1 },
        "dnsZoneResourceGroup": { "type": "string", "minLength": 1 },
        "serviceBusNamespace": { "type": "string", "pattern": "^[a-zA-Z0-9-]+\\.servicebus\\.windows\\.net$" },
        "serviceBusNamespaceName": { "type": "string", "pattern": "^[a-zA-Z0-9-]+$" },
        "serviceBusQueue": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "clientIds": {
          "type": "object",
          "required": [
            "order-service", "payment-service", "shipping-service", "worker",
            "external-dns", "external-secrets", "keda"
          ],
          "additionalProperties": { "$ref": "#/definitions/guid" }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "workloadIdentity": { "type": "boolean" } }
      }
    }
  },
  "definitions": {
    "guid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
