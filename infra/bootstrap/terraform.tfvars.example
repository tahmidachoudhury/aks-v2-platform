# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.

# Required. The subscription to deploy into. The provider uses only this
# value, never ARM_SUBSCRIPTION_ID or the az CLI default subscription.
subscription_id = "00000000-0000-0000-0000-000000000000"

# Globally unique, 3 to 24 lowercase letters and digits.
storage_account_name = "stakstfstate1234"

# Budget alert recipients. Use real addresses only in terraform.tfvars.
budget_contact_emails = ["you@example.com"]

# Optional overrides.
# location                   = "uksouth"
# resource_group_name        = "rg-aks-v2-tfstate"
# container_name             = "tfstate"
# soft_delete_retention_days = 14
# budget_amount              = 100
# budget_start_date          = "2026-11-01T00:00:00Z"
