HEALTH_PORT=8091
# No password: lib/pq reads PGPASSWORD from the scheduler Secret.
DATABASE_URL=postgres://app@postgres.data.svc.cluster.local:5432/orders?sslmode=disable
# abandoned_carts cancels through order-service, expire_reservations
# releases stock through inventory-service.
ORDER_SERVICE_URL=http://order-service:8081
INVENTORY_SERVICE_URL=http://inventory-service:8082
