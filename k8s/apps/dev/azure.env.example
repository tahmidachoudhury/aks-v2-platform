# The shape of azure.env, which is gitignored. Don't copy this file into
# place: an apply would point the services at the example registry and
# identities. make apps writes azure.env from the persistent and platform
# outputs, and stops before writing it if any value is missing or malformed.
acrLoginServer=acraksv2example.azurecr.io
serviceBusNamespace=sb-aks-v2-platform-1234.servicebus.windows.net
serviceBusQueue=order-events
order-service=00000000-0000-0000-0000-000000000001
payment-service=00000000-0000-0000-0000-000000000002
shipping-service=00000000-0000-0000-0000-000000000003
worker=00000000-0000-0000-0000-000000000004
